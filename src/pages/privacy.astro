---
import PrivacyPage from "@/components/infopages/Privacy.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";

const seo: AstroSeoProps = {
	title: "Aviso de privacidad — Metarrelato",
	description:
		"Cómo Metarrelato trata y protege los datos personales que compartes a través de este sitio y de sus formularios de contacto.",
	canonical: "https://metarrelato.com/privacy/",
};
---

<BaseLayout seo={seo}>
	<PrivacyPage />
</BaseLayout>
