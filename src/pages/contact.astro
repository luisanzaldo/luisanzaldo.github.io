---
import Contact from "@/components/forms/Contact.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";

const seo: AstroSeoProps = {
	title: "Metarrelato Contacto: Solicita una cita o envía un correo electrónico",
	description:
		"Agenda una videollamada o escríbenos para platicar sobre tu proyecto. Desarrollo de sitios web, automatizaciones e integraciones digitales a la medida.",
	canonical: "https://metarrelato.com/contact/",
};
---

<BaseLayout seo={seo}>
	<Contact />
</BaseLayout>
