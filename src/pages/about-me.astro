---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const points = [
	{
		icon: "ic:baseline-mic",
		title: "De la comunicación al código",
		content:
			"Vengo de la comunicación y el periodismo. Antes de escribir software me dediqué a escuchar, preguntar y contar historias, esta forma de trabajar sigue siendo la base de cómo entiendo un proyecto antes de construirlo.",
	},
	{
		icon: "ic:baseline-psychology",
		title: "Investigación sobre Inteligencia Artificial",
		content:
			"Investigo cómo la Inteligencia Artificial está cambiando la manera en que trabajamos, creamos y nos informamos. Me interesa menos la promesa publicitaria y más lo que ocurre cuando la tecnología aterriza en el día a día de la gente.",
	},
	{
		icon: "ic:baseline-balance",
		title: "Usos éticos de la tecnología",
		content:
			"Toda herramienta carga con decisiones sobre quién se beneficia y quién queda fuera. Trabajo con esa pregunta al frente: qué datos se usan, con qué permiso y a quién responde el sistema cuando se equivoca.",
	},
	{
		icon: "ic:baseline-shield",
		title: "Los límites que hacen falta",
		content:
			"Creo que la conversación sobre Inteligencia Artificial necesita hablar de restricciones con la misma seriedad con la que habla de capacidades. Hay usos que conviene acotar y decirlo también es parte del trabajo técnico.",
	},
	{
		icon: "ic:baseline-volunteer-activism",
		title: "Tecnología para causas sociales",
		content:
			"Las organizaciones que persiguen un fin social suelen tener las necesidades más complejas y los presupuestos más ajustados. Me interesa especialmente que esas herramientas también lleguen ahí.",
	},
	{
		icon: "ic:baseline-handyman",
		title: "Herramientas accesibles y democráticas",
		content:
			"La curiosidad me llevó a desarrollar soluciones que no dependan de presupuestos enormes ni de equipos técnicos grandes: sitios web, automatizaciones e integraciones que un profesionista, una pyme o un emprendimiento puedan usar desde el primer día.",
	},
];

const seo: AstroSeoProps = {
	title: "Acerca de mí — Metarrelato",
	description: "Luis Anzaldo: comunicación, periodismo y desarrollo de herramientas digitales accesibles para negocios, emprendimientos y causas sociales.",
	canonical: "https://metarrelato.com/about-me",
	noindex: true,
	nofollow: true,
};
---

<BaseLayout seo={seo}>
	<section>
		<div class="mx-auto flex flex-col gap-16 px-8 py-24 md:px-12 lg:pt-32 2xl:max-w-7xl">
			<header class="flex flex-col items-center gap-10 pt-20 text-center md:flex-row md:items-center md:gap-14 md:text-left">
				<div class="relative shrink-0">
					<div class="absolute -inset-4 rounded-full bg-[#f43f5e]/10"></div>
					<div
						class="relative flex h-40 w-40 items-center justify-center overflow-hidden rounded-full bg-zinc-900 ring-4 ring-[#f43f5e] md:h-52 md:w-52">
						{/* Provisional: sustituir por la foto de perfil manteniendo el círculo.
						    <img src="/images/luis-anzaldo.jpg" alt="Luis Anzaldo" class="h-full w-full object-cover" /> */}
						<img src="/logo.svg" alt="Logotipo de Metarrelato" class="h-24 w-24 md:h-32 md:w-32" />
					</div>
				</div>

				<div class="flex flex-col items-center gap-4 md:items-start">
					<div class="inline-flex items-center gap-4">
						<div class="hidden h-1 w-20 bg-black md:block"></div>
						<span class="font-mono text-xs font-semibold uppercase tracking-wide">Luis Anzaldo</span>
					</div>
					<h1 class="font-display text-6xl font-extrabold text-balance hyphens-manual sm:text-7xl md:text-8xl lg:text-9xl">
						Acerca de mí
					</h1>
				</div>
			</header>

			<div class="flex flex-col gap-6">
				<p class="text-xl leading-relaxed text-zinc-800">
					Mi nombre es <strong class="font-semibold">Luis Anzaldo</strong> y estoy al frente de este proyecto.
					<strong class="font-semibold">Metarrelato</strong> nació de una idea sencilla: las herramientas digitales que hoy dan ventaja
					a grandes empresas deberían estar al alcance de cualquier persona que tenga algo que construir.
				</p>
				<p class="text-lg leading-relaxed text-zinc-800">
					Empecé en la comunicación y el periodismo, por esta razón disfruto de investigar antes de opinar. Esta curiosidad terminó
					llevándome al desarrollo de sitios web, automatizaciones e integraciones digitales para profesionistas, emprendedores,
					pymes, negocios y causas sociales. Hoy combino las dos cosas: escribo sobre el impacto social de la Inteligencia Artificial
					y construyo las herramientas que la ponen a trabajar para quien normalmente no tendría acceso a ella.
				</p>
			</div>

			<div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:gap-10">
				{
					points.map(({ icon, title, content }) => (
						<article class="group flex flex-col gap-4 rounded-lg border border-zinc-200 bg-white p-8 transition-colors hover:border-[#f43f5e]">
							<div class="flex h-12 w-12 items-center justify-center rounded-full bg-[#f43f5e]/10 text-[#f43f5e] transition-colors group-hover:bg-[#f43f5e] group-hover:text-white">
								<Icon name={icon} class="h-7 w-7" />
							</div>
							<h2 class="font-mono text-lg font-medium uppercase tracking-wide text-black lg:text-xl">{title}</h2>
							<p class="text-base leading-relaxed text-slate-600">{content}</p>
						</article>
					))
				}
			</div>

			<div class="flex flex-col items-center gap-8 px-8 py-16 text-center md:px-16">
				<Icon name="ic:baseline-lightbulb" class="h-10 w-10 text-[#d4eb28]" />
				{/* leading-tight: con el line-height 1 que Tailwind aplica en text-5xl, los
				    descendentes de la Midnight (y, p, g) se cortan contra la línea siguiente. */}
				<p class="max-w-4xl font-display text-3xl font-extrabold leading-tight text-balance text-black md:text-4xl lg:text-5xl">
					Si tienes una idea y no sabes por dónde empezar, esa conversación es justo la parte que más disfruto.
				</p>
				<div class="squircle-bg rounded-lg !bg-[#f43f5e]" data-cursor-hover data-cursor-parallax>
					<a
						class="flex h-10 w-full max-w-52 flex-1 items-center justify-center px-6 py-2 text-xl text-slate-200 transition-all hover:text-white sm:w-auto md:font-bold lg:h-10"
						aria-label="Ir a la página de contacto"
						href={translatePath("/contact/")}>
						{t("contact")}
					</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
