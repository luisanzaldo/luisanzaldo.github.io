---
import Error404 from "@/components/infopages/Error404.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";

const seo: AstroSeoProps = {
	title: "Página no encontrada — Metarrelato",
	description:
		"Esta página no existe o cambió de dirección. Vuelve al inicio para ver las herramientas digitales que desarrollamos en Metarrelato.",
	canonical: "https://metarrelato.com/404/",
};
---

<BaseLayout seo={seo}>
	<Error404 />
</BaseLayout>
