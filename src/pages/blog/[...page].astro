---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";
import Articles from "@components/blog/Articles.astro";
import Cta from "@components/blog/Cta.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths({ paginate }) {
    // The site is Spanish-only; content lives under the "es" locale folder.
    const lang = "es";
    const allPosts = (await getCollection("posts"))
        .filter((post) => {
            const [postLang, ...slug] = post.slug.split("/");
            return postLang === lang;
        })
        .map((post) => {
            const [postLang, slug] = post.slug.split("/");
            return {
                ...post,
                slug: slug,
            };
        })
        .sort((a, b) => Number(b.data.pubDate) - Number(a.data.pubDate));

    return paginate(allPosts, { pageSize: 10 });
}

const { page } = Astro.props;

const seo: AstroSeoProps = {
	title: "Metarrelato Blog: Análisis de Inteligencia Artificial y su impacto en la sociedad",
	description:
		"Artículos sobre inteligencia artificial, herramientas digitales y su impacto en la sociedad, desde la mirada de Metarrelato.",
	canonical: "https://metarrelato.com/blog/",
	// og:title, og:description, og:url y la imagen de compartir los deriva BaseLayout.
	twitter: {
		handle: "@metarrelato",
		site: "@metarrelato",
		cardType: "summary_large_image",
	},
};
---

<BaseLayout seo={seo}>
	<Articles page={page} />
	<Cta />
</BaseLayout>
