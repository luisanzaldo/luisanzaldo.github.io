---
import TermsPage from "@/components/infopages/Terms.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";

const seo: AstroSeoProps = {
	title: "Términos y condiciones — Metarrelato",
	description:
		"Condiciones de uso del sitio y de las herramientas digitales de Metarrelato: qué puedes esperar de nosotros y qué esperamos de ti.",
	canonical: "https://metarrelato.com/terms/",
};
---

<BaseLayout seo={seo}>
	<TermsPage />
</BaseLayout>
