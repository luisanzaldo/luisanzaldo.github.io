---
import { getCollection } from "astro:content";
import type { AstroSeoProps } from "@astrolib/seo";
import Authors from "@components/blog/Authors.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const allAuthors = await getCollection("authors");
const pageTitle = "Tag Index";

const seo: AstroSeoProps = {
	title: "Autores — Metarrelato",
	description:
		"Conoce a quienes escriben en el blog de Metarrelato: análisis sobre inteligencia artificial, herramientas digitales y su impacto en la sociedad.",
	canonical: "https://metarrelato.com/author/",
};
---

<BaseLayout seo={seo}>
	<Authors />
</BaseLayout>
