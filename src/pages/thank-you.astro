---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";
import Thanks from "@components/infopages/ThankYou.astro";

const seo: AstroSeoProps = {
	title: "Gracias por escribir — Metarrelato",
	description:
		"Recibimos tu mensaje. Te respondemos en breve para agendar una videollamada y platicar sobre tu proyecto.",
	canonical: "https://metarrelato.com/thank-you/",
};
---

<BaseLayout seo={seo}>
	<Thanks />
</BaseLayout>
