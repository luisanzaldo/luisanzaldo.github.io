---
import BlobCursorFollower from "@/components/global/BlobCursorFollower.astro";
import { AstroSeo, type AstroSeoProps } from "@astrolib/seo";
import BaseHead from "@components/BaseHead.astro";
import BackgroundTexture from "@components/global/BackgroundTexture.astro";
import Footer from "@components/global/Footer.astro";
import Navigation from "@components/global/Navigation.astro";
import { getLangFromUrl } from "../i18n/utils";

const { pathname } = Astro.url;

type Props = {
	seo?: AstroSeoProps;
};

const { seo: seoProp } = Astro.props;

const lang = getLangFromUrl(Astro.url);

const shareImage = new URL("/images/meta/metarrelato_share.png", Astro.site).toString();

const defaultSeo: AstroSeoProps = {
	title: "Metarrelato - Herramientas digitales para tu negocio, emprendimiento o causa social",
	description:
		"Desarrollo de sitios web, automatizaciones e integraciones digitales para emprendedores, pymes y causas sociales. Herramientas a la medida de tu proyecto.",
	canonical: "https://metarrelato.com",
	openGraph: {
		url: "https://metarrelato.com",
		title: "Metarrelato - Herramientas digitales para tu negocio, emprendimiento o causa social",
		description:
			"Desarrollo de sitios web, automatizaciones e integraciones digitales para emprendedores, pymes y causas sociales. Herramientas a la medida de tu proyecto.",
		images: [
			{
				url: shareImage,
				width: 1200,
				height: 630,
				alt: "Logotipo de Metarrelato",
				type: "image/png",
			},
		],
		site_name: "Metarrelato",
	},
	twitter: {
		handle: "@metarrelato",
		site: "@metarrelato",
		cardType: "summary_large_image",
	},
	additionalMetaTags: [
		{
			name: "publisher",
			content: "Metarrelato",
		},
	],
};

const mergedSeo = {
	...defaultSeo,
	...seoProp,
};

// El spread es superficial: una página que define `seo` sin `openGraph` heredaría
// entero el bloque de la home. Lo combinamos y hacemos que el título, la descripción
// y la url de Open Graph sigan a los de la página cuando no se declaran aparte.
const seo: AstroSeoProps = {
	...mergedSeo,
	openGraph: {
		...defaultSeo.openGraph,
		...seoProp?.openGraph,
		title: seoProp?.openGraph?.title ?? mergedSeo.title,
		description: seoProp?.openGraph?.description ?? mergedSeo.description,
		// og:url debe ser absoluta y coincidir con la canónica: es la llave con la
		// que Meta/WhatsApp agrupan el caché de previews.
		url: new URL(mergedSeo.canonical ?? "/", Astro.site).toString(),
	},
};

function cursorFollowerActive() {
	const paths = ["", "/"];
	return paths.includes(pathname);
}
---

<html lang={lang}>
	<head>
		<BaseHead />
		<AstroSeo {...seo} />
	</head>
	<body class="bg-slate-50">
		<BackgroundTexture />
		<Navigation />
		<slot />
		{
			!pathname.includes('/blog') && !pathname.includes('/posts') && !pathname.includes('/contact') && !pathname.includes('/work') && !pathname.includes('/tags') && (
				<Footer />
			)
		}
	<script is:inline>
		// Force page to start at top on refresh/reload
		if (history.scrollRestoration) {
			history.scrollRestoration = 'manual';
		}
		
		window.addEventListener('load', function() {
			window.scrollTo(0, 0);
		});
	</script>
	</body>
</html>
