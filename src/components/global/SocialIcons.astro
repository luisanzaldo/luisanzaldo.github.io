---
interface Props {
	/** Clases de color del icono (p. ej. "text-[#F06071]") */
	iconColor?: string;
	/** Clases de color al pasar el cursor */
	iconHover?: string;
	/** Tamaño del icono en píxeles */
	size?: number;
	/** Clases aplicadas al <svg> de cada icono: sirven para dar un tamaño fluido que
	    sobrescriba a `size` (p. ej. "w-[min(3.5rem,12vw)] h-[min(3.5rem,12vw)]") */
	iconClass?: string;
	/** Incluir el icono de correo junto a las redes sociales */
	showEmail?: boolean;
	class?: string;
}

const { iconColor = "", iconHover = "", size = 40, iconClass = "", showEmail = true, class: className = "flex gap-6" } = Astro.props;
