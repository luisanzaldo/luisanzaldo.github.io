---
import SocialIcons from "@components/global/SocialIcons.astro";

const pathname = Astro.url.pathname;
const isBlog = pathname.includes('/blog') || pathname.includes('/posts');

const footerBg = isBlog ? "bg-slate-50" : "bg-zinc-900";
const textColor = isBlog ? "text-zinc-900" : "text-white";
const iconColor = isBlog ? "text-[#F06071]" : "text-[#d4eb28]";
const iconHover = isBlog ? "hover:text-black" : "hover:text-white";
const goTopColor = isBlog ? "text-zinc-900 hover:fill-zinc-900 hover:text-white" : "text-white hover:fill-white hover:text-black";
---

<footer class:list={["section relative flex min-h-[50vh] w-full flex-col items-center justify-center gap-y-10 py-10 lg:min-h-[50vh]", footerBg]}>
	<div id="footer-content" class="flex flex-col items-center gap-8">
		<!-- Social Icons -->
		<SocialIcons iconColor={iconColor} iconHover={iconHover} />

		<!-- Copyright -->
		<div class:list={["text-lg font-medium", textColor]}>
			@2026 metarrelato
		</div>
	</div>

	<!-- Scroll Top Button -->
	<div class="absolute bottom-4 right-4 lg:bottom-10 lg:right-10">
		<button
			id="go-top-button"
			aria-label="Go to Top"
			class:list={["fill-transparent transition-colors duration-300", goTopColor]}
			data-cursor-hover
			data-cursor-parallax>
			<svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24">
				<g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5">
					<circle cx="12" cy="12" r="9"></circle><path d="m15 12l-3-3m0 0l-3 3m3-3v6"></path>
				</g>
			</svg>
		</button>
	</div>
</footer>

<style>
	footer {
		@apply relative flex w-full flex-col;
	}
</style>

<script>
	import { gsap } from "gsap";
	import { ScrollToPlugin } from "gsap/ScrollToPlugin";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollToPlugin, ScrollTrigger);

	function init() {
		var goTopButton = document.getElementById("go-top-button");

		// Footer Content Animation
		gsap.from("#footer-content", {
			scale: 0,
			opacity: 0,
			duration: 1,
			ease: "back.out(1.7)",
			scrollTrigger: {
				trigger: "footer",
				start: "top 90%",
				toggleActions: "play none none reverse",
			},
		});

		if (!goTopButton) return;

		goTopButton.addEventListener("click", function () {
			gsap.to(window, { duration: 0.5, scrollTo: 0 });
		});
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", () => requestAnimationFrame(init));
	} else {
		requestAnimationFrame(init);
	}
</script>
