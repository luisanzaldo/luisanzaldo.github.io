---
import SocialIcons from "@components/global/SocialIcons.astro";
---

<section class="bg-zinc-900">
	<div class="mx-auto max-w-7xl px-8 py-6 md:px-12 lg:px-16 lg:py-12">
		<div class="flex flex-col items-center justify-center gap-10 py-8 text-center lg:py-16">
			{/* El <br> fija el corte en dos líneas desde md; abajo de esa medida el
			    título no cabe en dos líneas sin quedar diminuto y se deja fluir. */}
			<p class="mt-8 font-display text-[2.56rem] font-semibold text-white md:text-[3.25rem] lg:text-[4.375rem] xl:text-[5.625rem] leading-[0.9] text-balance">
				Síguenos en nuestras<br class="hidden md:inline" /> redes sociales
			</p>
			<SocialIcons
				iconColor="text-[#d4eb28]"
				iconHover="hover:text-white"
				size={56}
				class="flex flex-wrap items-center justify-center gap-8"
			/>
		</div>
	</div>
</section>
