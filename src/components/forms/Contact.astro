---
import Title from "@components/global/Title.astro";

import { getLangFromUrl, useTranslations, useTranslatedPath } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<section class="isolate px-6 py-24 sm:py-32 lg:px-8">
	<div class="mx-auto">
		<Title class="pb-10 pt-20 uppercase" title={t("contact.title")} subtitle={t("contact.subtitle")} />

		<!-- Chatbot Interface -->
		<div class="mx-auto max-w-2xl pt-12 lg:pt-20">
			<div class="bg-white/50 backdrop-blur-sm rounded-2xl shadow-[0_0_25px_rgba(0,0,0,0.1)] overflow-hidden border border-white/20">
				<!-- Chat History -->
				<div id="chat-history" class="h-[400px] overflow-y-auto p-6 space-y-4 bg-slate-50/50">
					<div class="flex flex-col gap-2 w-full">
						<div class="self-start bg-slate-200 rounded-lg rounded-tl-none px-4 py-2 max-w-[85%] text-slate-800 shadow-sm prose prose-slate prose-sm max-w-none break-words overflow-x-auto">
							<p>¡Hola! Si deseas agendar una videollamada con gusto puedo ayudarte. Solo compárteme tu nombre, correo electrónico, el día y hora en que deseas platicar con nosotros y el tema que te gustaría abordar.<br /><br />También puedo brindarte información sobre los servicios que <strong>metarrelato</strong> ofrece.</p>
						</div>
					</div>
				</div>

				<!-- Input Area -->
				<div class="p-4 bg-white border-t border-slate-100">
					<div class="flex gap-4 items-end">
						<textarea
							id="chat-input"
							class="flex-1 bg-slate-100 border-0 rounded-xl px-4 py-3 text-slate-800 focus:ring-2 focus:ring-purple-500 outline-none transition-all placeholder:text-slate-400 resize-none max-h-32 min-h-[48px]"
							placeholder={t("contact.message")}
							rows="1"
						></textarea>
						<button
							id="send-button"
							class="bg-[#F06071] text-white p-3 rounded-xl hover:bg-[#F06071]/80 transition-colors flex items-center justify-center aspect-square shadow-lg hover:shadow-xl transform hover:scale-105 shrink-0"
							aria-label={t("contact.send")}
						>
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
								<path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
							</svg>
						</button>
					</div>
					<div class="text-center mt-3">
						 <p class="text-xs text-slate-400">
							{t("contact.agree")} <a href="/privacy" class="font-semibold text-slate-600 hover:text-purple-600 transition-colors">privacy policy</a>.
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	import { marked } from 'marked';

	const chatInput = document.getElementById('chat-input') as HTMLTextAreaElement;
	const sendButton = document.getElementById('send-button');
	const chatHistory = document.getElementById('chat-history');
	let isSending = false;

	const BACKEND_URL = import.meta.env.PUBLIC_BACKEND_URL || 'https://metarrelato-chatbot-backend-metarrelato.hf.space';

	// Maintain conversation history locally
	let conversationHistory: { role: string, content: string }[] = [];

	// El Space de Hugging Face se duerme tras 48h sin actividad y tarda unos
	// 12 segundos en arrancar en frío. Le pegamos a /health en cuanto se abre
	// la página para que despierte mientras la persona lee y escribe, en vez
	// de que pague esa espera al enviar el primer mensaje.
	const WARMUP_THROTTLE_MS = 10 * 60 * 1000;
	let lastWarmupAt = 0;

	function warmUpBackend() {
		if (Date.now() - lastWarmupAt < WARMUP_THROTTLE_MS) return;
		lastWarmupAt = Date.now();

		// Sin await a propósito: es una petición de fuego y olvido que no debe
		// retrasar nada. Si falla, no importa; handleSend reintenta por su cuenta.
		fetch(`${BACKEND_URL}/health`).catch(() => {});
	}

	function addMessage(text: string, isUser: boolean) {
		if (!chatHistory) return;

		const wrapper = document.createElement('div');
		wrapper.className = `flex flex-col gap-2 w-full ${isUser ? 'items-end' : 'items-start'}`;

		const message = document.createElement('div');
		// Apply prose class for bot messages to render markdown nicely
		const proseClasses = isUser ? '' : 'prose prose-slate prose-sm max-w-none prose-p:leading-relaxed prose-pre:bg-slate-800 prose-pre:text-white break-words overflow-x-auto';
		message.className = `px-4 py-2 max-w-[85%] rounded-lg ${isUser ? 'bg-zinc-900 text-white rounded-tr-none shadow-md' : 'bg-slate-200 text-slate-800 rounded-tl-none shadow-sm'} ${proseClasses}`;

		if (isUser) {
			message.textContent = text;
		} else {
			// Parse markdown for bot messages
			message.innerHTML = marked.parse(text) as string;
		}

		wrapper.appendChild(message);
		chatHistory.appendChild(wrapper);
		chatHistory.scrollTop = chatHistory.scrollHeight;
		return wrapper;
	}

	// El backend vive en un Space de Hugging Face con hardware gratuito, que se
	// reinicia solo cada cierto tiempo. Durante esos 30-60 segundos el proxy
	// responde 502/503 y antes le mostrábamos el error a quien estuviera
	// escribiendo. Estas esperas suman ~89s, de sobra para cubrir el reinicio.
	const RETRY_DELAYS_MS = [2000, 4000, 8000, 15000, 25000, 35000];

	// Códigos que emite el proxy cuando el Space está caído o arrancando: la
	// petición no llegó a la aplicación, así que repetirla no duplica nada.
	const RETRIABLE_STATUS = [429, 502, 503, 504];

	const REQUEST_TIMEOUT_MS = 30000;

	const sleep = (ms: number) => new Promise(resolve => setTimeout(resolve, ms));

	function setStatusText(wrapper: HTMLElement | undefined, text: string) {
		const bubble = wrapper?.firstElementChild;
		if (bubble) bubble.textContent = text;
	}

	async function postChat(text: string): Promise<Response> {
		const controller = new AbortController();
		const timeoutId = setTimeout(() => controller.abort(), REQUEST_TIMEOUT_MS);

		try {
			return await fetch(`${BACKEND_URL}/chat`, {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
				},
				body: JSON.stringify({
					message: text,
					history: conversationHistory
				}),
				signal: controller.signal
			});
		} finally {
			clearTimeout(timeoutId);
		}
	}

	async function handleSend() {
		if (!chatInput || !chatInput.value.trim() || isSending) return;

		const text = chatInput.value;
		addMessage(text, true);
		chatInput.value = '';
		chatInput.style.height = 'auto'; // Reset height after send

		isSending = true;
		if (sendButton) {
			sendButton.setAttribute('disabled', 'true');
			sendButton.style.opacity = '0.5';
		}

		const statusIndicator = addMessage('Escribiendo...', false);

		try {
			let data: { reply?: string } | null = null;

			for (let attempt = 0; ; attempt++) {
				const canRetry = attempt < RETRY_DELAYS_MS.length;
				let response: Response;

				try {
					response = await postChat(text);
				} catch (error) {
					// AbortError significa que expiró nuestro propio timeout, no que
					// el backend esté caído: pudo haber procesado el mensaje y hasta
					// agendado la cita. Reintentar ahí duplicaría el evento en el
					// calendario, así que se deja fallar.
					if ((error as Error).name === 'AbortError' || !canRetry) throw error;
					setStatusText(statusIndicator, 'Reconectando...');
					await sleep(RETRY_DELAYS_MS[attempt]);
					continue;
				}

				if (RETRIABLE_STATUS.includes(response.status) && canRetry) {
					setStatusText(statusIndicator, 'Reconectando...');
					await sleep(RETRY_DELAYS_MS[attempt]);
					continue;
				}

				if (!response.ok) throw new Error(`El backend respondió ${response.status}`);

				data = await response.json();
				break;
			}

			if (statusIndicator) statusIndicator.remove();

			const botMessage = data?.reply || "Lo siento, no pude procesar la respuesta.";

			// Save in local history for subsequent requests
			conversationHistory.push({ role: 'user', content: text });
			conversationHistory.push({ role: 'assistant', content: botMessage });

			addMessage(botMessage, false);
		} catch (error) {
			console.error('Chat error:', error);
			if (statusIndicator) statusIndicator.remove();
			addMessage("Hubo un problema al conectar. Por favor intenta de nuevo en un momento.", false);

			// Devolvemos el texto al recuadro para que no haya que reescribirlo.
			if (chatInput && !chatInput.value.trim()) {
				chatInput.value = text;
				chatInput.style.height = 'auto';
				chatInput.style.height = `${chatInput.scrollHeight}px`;
			}
		} finally {
			isSending = false;
			if (sendButton) {
				sendButton.removeAttribute('disabled');
				sendButton.style.opacity = '1';
			}
		}
	}

	sendButton?.addEventListener('click', handleSend);

	chatInput?.addEventListener('input', () => {
		chatInput.style.height = 'auto';
		chatInput.style.height = `${chatInput.scrollHeight}px`;
	});

	// Al abrir la página, y otra vez si alguien vuelve al recuadro tras dejar
	// la pestaña abierta un buen rato (el throttle evita repetirlo de más).
	warmUpBackend();
	chatInput?.addEventListener('focus', warmUpBackend);

	chatInput?.addEventListener('keydown', (e) => {
		if (e.key === 'Enter' && e.shiftKey) {
			e.preventDefault();
			handleSend();
		}
	});

</script>

